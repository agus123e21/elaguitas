# Puerto del backend
PORT=4000

# Entorno: development | production
NODE_ENV=development

# Conexión a PostgreSQL (Supabase)
# Obtenerla en Supabase: Project Settings -> Database -> Connection string (Node.js / postgresql://...)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Secreto para firmar JWT (cambiar por un valor largo y aleatorio)
JWT_SECRET=change_me_por_favor_una_cadena_larga_y_segura

# Duración del token en segundos (7 días por defecto)
JWT_EXPIRES_IN=604800

# URL del frontend (para CORS en producción)
FRONTEND_URL=http://localhost:5173
